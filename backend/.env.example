# Copy this file to backend/.env for local development.
# These values are placeholders. Do not put real passwords, production URLs, or tokens here.

# Application metadata database. Alembic may use only this URL, and only when
# SCHEMAPILOT_ALLOW_APP_MIGRATIONS=true. Startup never runs migrations.
SCHEMAPILOT_APP_DATABASE_URL=postgresql+psycopg://schemapilot:change_me_local_app@127.0.0.1:5432/schemapilot

# Disposable sandbox database. Keep this distinct from the application database and any target.
SCHEMAPILOT_SANDBOX_DATABASE_URL=postgresql+psycopg://schemapilot_sandbox:change_me_local_sandbox@127.0.0.1:5433/schemapilot_sandbox

# Bookstore demo source. Initialization runs only when the environment is "disposable"
# and the database name is schemapilot_bookstore. Startup does not initialize it.
# Schema inspection reads this URL in a separate read-only session. Inspection does not
# require SCHEMAPILOT_ALLOW_DEMO_RESET and does not call demo initialization or reset.
SCHEMAPILOT_DEMO_DATABASE_URL=postgresql+psycopg://schemapilot_demo:change_me_local_demo@127.0.0.1:5434/schemapilot_bookstore
SCHEMAPILOT_DEMO_ENVIRONMENT=disposable

# Destructive demo reset. Leave false until you intend to drop the bookstore schema.
SCHEMAPILOT_ALLOW_DEMO_RESET=false

# Disposable sandbox execution. Leave false until sandbox-db is running and you intend
# to drop and rebuild schema bookstore on schemapilot_sandbox only.
SCHEMAPILOT_ALLOW_SANDBOX_EXECUTION=false

# Optional later. Leave empty. Target execution stays disabled.
SCHEMAPILOT_TARGET_DATABASE_URL=
SCHEMAPILOT_TARGET_EXECUTION_ENABLED=false

# Real authentication is not implemented. Keep false. Approvals fail closed.
SCHEMAPILOT_AUTHENTICATION_AVAILABLE=false

# Manual Alembic opt-in for the application database only. Leave false until you intend to migrate.
SCHEMAPILOT_ALLOW_APP_MIGRATIONS=false

# Optional LLM assist (server-side only). Leave disabled unless you intentionally configure a key.
# The API key never appears in API responses, workflow records, or the frontend.
SCHEMAPILOT_LLM_ENABLED=false
SCHEMAPILOT_LLM_API_KEY=
SCHEMAPILOT_LLM_API_BASE=https://api.openai.com/v1
SCHEMAPILOT_LLM_MODEL=gpt-4o-mini
SCHEMAPILOT_LLM_TIMEOUT_SECONDS=20
SCHEMAPILOT_LLM_FALLBACK_TO_DETERMINISTIC=true
SCHEMAPILOT_LLM_PROVIDER=openai_compatible

# Local Vite origins.
SCHEMAPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose database passwords. Local placeholders only.
SCHEMAPILOT_APP_DB_USER=schemapilot
SCHEMAPILOT_APP_DB_PASSWORD=change_me_local_app
SCHEMAPILOT_APP_DB_NAME=schemapilot
SCHEMAPILOT_SANDBOX_DB_USER=schemapilot_sandbox
SCHEMAPILOT_SANDBOX_DB_PASSWORD=change_me_local_sandbox
SCHEMAPILOT_SANDBOX_DB_NAME=schemapilot_sandbox
SCHEMAPILOT_DEMO_DB_USER=schemapilot_demo
SCHEMAPILOT_DEMO_DB_PASSWORD=change_me_local_demo
SCHEMAPILOT_DEMO_DB_NAME=schemapilot_bookstore
